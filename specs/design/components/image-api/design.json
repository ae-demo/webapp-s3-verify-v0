{
  "name": "image-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "image-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    1,
    2,
    3,
    4
  ],
  "description": "Owns image metadata (owner, S3 object key, filename, content type, size, upload time) in image-db, and issues short-lived S3 presigned URLs for upload and view so image bytes never pass through this service. Enforces that a caller only ever lists or reads their own images, keyed off the Thunder-signed caller identity. Does not store or proxy image bytes itself.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "image-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "webapp-s3-verify-05020967",
        "envBindings": {
          "dbname": "IMAGE_DB_DBNAME",
          "host": "IMAGE_DB_HOST",
          "password": "IMAGE_DB_PASSWORD",
          "port": "IMAGE_DB_PORT",
          "user": "IMAGE_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "webapp-s3-verify-bd5b5d73",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "external",
      "name": "aws-s3",
      "description": "Issues presigned S3 PutObject/GetObject URLs for uploading and viewing images, and holds the AWS credentials — never exposed to the browser.",
      "wiring": {
        "ref": "webapp-s3-verify-v0-aws-s3",
        "envBindings": {
          "AWS_ACCESS_KEY_ID": "AWS_ACCESS_KEY_ID",
          "AWS_REGION": "AWS_REGION",
          "AWS_SECRET_ACCESS_KEY": "AWS_SECRET_ACCESS_KEY",
          "S3_BUCKET_NAME": "S3_BUCKET_NAME"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
